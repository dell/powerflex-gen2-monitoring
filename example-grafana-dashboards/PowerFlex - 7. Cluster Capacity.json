          "query": "SELECT mean(\"unusedCapacityInKb\")  / 2 FROM \"scaleio.cluster\" WHERE (\"cluster\" =~ /^$cluster$/) AND $timeFilter GROUP BY time($__interval), \"cluster\" fill(null)",
